---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
  image?: string;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  type = 'website',
  publishedDate,
  updatedDate,
  image = '/social-card.svg',
} = Astro.props;
const imageUrl = new URL(image, Astro.site ?? Astro.url).href;
const documentTitle = title.includes('Decisiones que sí suman')
  ? title
  : `${title} · Decisiones que sí suman`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'Article' : 'WebSite',
  name: title,
  description,
  url: canonical,
  inLanguage: 'es-CO',
  ...(type === 'article'
    ? {
        author: { '@type': 'Person', name: 'José Carlos Gómez' },
        publisher: { '@type': 'Organization', name: 'Decisiones que sí suman' },
        ...(publishedDate ? { datePublished: publishedDate.toISOString() } : {}),
        ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
      }
    : {}),
};
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#164B4A" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Actividades" href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Decisiones que sí suman" />
    <meta property="og:image" content={imageUrl} />
    <meta
      property="og:image:alt"
      content="Decisiones que sí suman, proyecto de educación financiera"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta
      name="twitter:image:alt"
      content="Decisiones que sí suman, proyecto de educación financiera"
    />
    {
      publishedDate && (
        <meta property="article:published_time" content={publishedDate.toISOString()} />
      )
    }
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <title>{documentTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      let savedTheme = null;
      try {
        savedTheme = localStorage.getItem('dqs-theme');
      } catch {
        savedTheme = null;
      }
      if (savedTheme === 'dark') {
        document.body.dataset.theme = 'dark';
        document.documentElement.style.colorScheme = 'dark';
      }
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        button.addEventListener('click', () => {
          const dark = document.body.dataset.theme !== 'dark';
          document.body.dataset.theme = dark ? 'dark' : 'light';
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
          try {
            localStorage.setItem('dqs-theme', dark ? 'dark' : 'light');
          } catch {
            // El tema sigue funcionando aunque el navegador bloquee almacenamiento.
          }
          document.dispatchEvent(new CustomEvent('themechange', { detail: { dark } }));
        });
      });
    </script>
  </body>
</html>
