---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import StatusBadge from '../components/StatusBadge.astro';
import DocumentTabs from '../components/documents/DocumentTabs.astro';
import type { DocumentEntry } from '../lib/documents';

const plan = await getEntry('plan', 'plan-humanidades-digitales');
if (!plan) throw new Error('No se encontró el plan de Humanidades Digitales.');
const documents = await getCollection('document');
const relatedDocument = documents.find(
  (document) => document.data.slug === plan.data.documentSlug,
) as DocumentEntry | undefined;
if (!relatedDocument) throw new Error('No hay documento público relacionado con el plan.');
const { Content } = await render(plan);
---

<BaseLayout
  title={plan.data.title}
  description={plan.data.description}
  type="article"
  updatedDate={plan.data.updatedDate}
>
  <article class="section plan-page">
    <div class="site-shell">
      <Breadcrumbs items={[{ label: 'Plan de Humanidades Digitales' }]} />
      <header class="plan-header">
        <div><span class="kicker">Ruta de intervención</span><h1>{plan.data.title}</h1></div><div
          class="plan-stamp"
        >
          <span class="eyebrow-data">Estado</span><StatusBadge status={plan.data.status} /><span
            class="eyebrow-data"
            >Actualizado {
              plan.data.updatedDate.toLocaleDateString('es-CO', { timeZone: 'UTC' })
            }</span
          >
        </div>
      </header>
      <DocumentTabs document={relatedDocument}>
        <div slot="web">
          <div class="plan-layout">
            <aside class="plan-aside">
              <p class="eyebrow-data">Territorio</p>
              <strong>{plan.data.territory}</strong>
              <div class="rule"></div>
              <p class="eyebrow-data">Publicaciones</p>
              <strong>6 registradas</strong>
              <p class="eyebrow-data">Entrevista</p>
              <strong>7:20 publicada</strong>
              <p class="eyebrow-data">Webinar</p>
              <strong>69:01 publicado</strong>
              <p class="eyebrow-data">Evaluación posterior</p>
              <strong>6 respuestas</strong>
            </aside>
            <div class="prose">
              <Content />
            </div>
          </div>
          <nav class="plan-navigation" aria-label="Navegación del plan">
            <a href="/actividades/">Ver actividades →</a>
            <a href={relatedDocument.data.publicVersion} target="_blank" rel="noreferrer">
              Ver documento original ↗
            </a>
            <a href={relatedDocument.data.publicVersion} download>
              {
                relatedDocument.data.documentSource === 'original'
                  ? 'Descargar documento original'
                  : 'Descargar versión pública'
              }
            </a>
          </nav>
        </div>
      </DocumentTabs>
    </div>
  </article>
</BaseLayout>

<style>
  .plan-header {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: end;
    padding-block: 3rem 4rem;
  }
  .plan-header h1 {
    max-width: 12ch;
    margin: 0.8rem 0 0;
  }
  .plan-stamp {
    display: grid;
    gap: 0.7rem;
    min-width: 12rem;
    padding: 1rem;
    border: 1px solid var(--line);
    background: var(--paper-deep);
  }
  .plan-layout {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .plan-aside {
    position: sticky;
    top: 1.5rem;
    display: grid;
    gap: 0.45rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--terracotta);
  }
  .plan-aside strong {
    color: var(--petrol);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.45rem;
    line-height: 1.1;
  }
  .plan-navigation {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .plan-navigation a {
    color: var(--petrol);
    font-weight: 800;
  }
  @media (max-width: 800px) {
    .plan-header,
    .plan-layout {
      display: grid;
      grid-template-columns: 1fr;
    }
    .plan-aside {
      position: static;
      grid-template-columns: repeat(2, 1fr);
    }
    .plan-aside .rule {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .plan-aside {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
