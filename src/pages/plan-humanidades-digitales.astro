---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Comments from '../components/Comments.astro';
import StatusBadge from '../components/StatusBadge.astro';

const plan = await getEntry('plan', 'plan-humanidades-digitales');
if (!plan) throw new Error('No se encontró el plan de Humanidades Digitales.');
const { Content } = await render(plan);
---

<BaseLayout
  title={plan.data.title}
  description={plan.data.description}
  type="article"
  updatedDate={plan.data.updatedDate}
>
  <article class="section plan-page">
    <div class="site-shell">
      <Breadcrumbs items={[{ label: 'Plan de Humanidades Digitales' }]} />
      <header class="plan-header">
        <div><span class="kicker">Ruta de intervención</span><h1>{plan.data.title}</h1></div><div
          class="plan-stamp"
        >
          <span class="eyebrow-data">Estado</span><StatusBadge status={plan.data.status} /><span
            class="eyebrow-data"
            >Actualizado {plan.data.updatedDate.toLocaleDateString('es-CO')}</span
          >
        </div>
      </header>
      <div class="plan-layout">
        <aside class="plan-aside">
          <p class="eyebrow-data">Territorio</p><strong>{plan.data.territory}</strong><div
            class="rule"
          >
          </div><p class="eyebrow-data">Publicaciones</p><strong>6 previstas</strong><p
            class="eyebrow-data"
          >
            Entrevista
          </p><strong>1 prevista</strong><p class="eyebrow-data">Webinar</p><strong
            >1 previsto</strong
          >
        </aside><div class="prose"><Content /></div>
      </div>
      <Comments pathname="/plan-humanidades-digitales/" enabled={true} />
    </div>
  </article>
</BaseLayout>

<style>
  .plan-header {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: end;
    padding-block: 3rem 4rem;
  }
  .plan-header h1 {
    max-width: 12ch;
    margin: 0.8rem 0 0;
  }
  .plan-stamp {
    display: grid;
    gap: 0.7rem;
    min-width: 12rem;
    padding: 1rem;
    border: 1px solid var(--line);
    background: var(--paper-deep);
  }
  .plan-layout {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .plan-aside {
    position: sticky;
    top: 1.5rem;
    display: grid;
    gap: 0.45rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--terracotta);
  }
  .plan-aside strong {
    color: var(--petrol);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.45rem;
    line-height: 1.1;
  }
  @media (max-width: 800px) {
    .plan-header,
    .plan-layout {
      display: grid;
      grid-template-columns: 1fr;
    }
    .plan-aside {
      position: static;
      grid-template-columns: repeat(3, 1fr);
    }
    .plan-aside .rule {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .plan-aside {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
