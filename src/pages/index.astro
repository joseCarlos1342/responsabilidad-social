---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ActivityCard from '../components/ActivityCard.astro';
import StatusBadge from '../components/StatusBadge.astro';
import DocumentCard from '../components/DocumentCard.astro';
import { sortActivities } from '../lib/content';
import { projectStatus, projectTimeline } from '../lib/project';
import { sortDocuments, validateDocuments } from '../lib/documents';

const activities = sortActivities(await getCollection('activity', ({ data }) => !data.draft));
const featured = activities.find((activity) => activity.data.featured) ?? activities[0];
const documents = sortDocuments(await getCollection('document'));
validateDocuments(documents);
---

<BaseLayout
  title="Educación financiera para decidir mejor"
  description="Blog académico de José Carlos Gómez sobre educación financiera, responsabilidad social y Humanidades Digitales en Neiva."
>
  <section class="home-hero section">
    <div class="site-shell home-hero__grid">
      <div class="home-hero__copy">
        <span class="kicker">Blog académico · Neiva, Huila</span>
        <h1>Decisiones que <em>sí</em> suman.</h1>
        <p class="lede">
          Educación financiera para organizar mejor el dinero, preguntar antes de decidir y
          construir hábitos posibles en la vida cotidiana.
        </p>
        <div class="button-row">
          <a class="button" href="/actividades/"
            >Explorar actividades <span aria-hidden="true">↗</span></a
          >
          <a class="button button--quiet" href="/plan-humanidades-digitales/">Ver el plan</a>
        </div>
      </div>
      <div class="decision-board" aria-label="Ruta visual de una decisión financiera">
        <div class="decision-board__head">
          <span class="eyebrow-data">Cuaderno de trabajo / 01</span>
          <span class="board-dot" aria-hidden="true"></span>
        </div>
        <div class="balance-line" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="decision-board__steps">
          <div><strong>01</strong><span>Observar</span><small>¿Qué está pasando?</small></div>
          <div><strong>02</strong><span>Ordenar</span><small>¿Qué entra y sale?</small></div>
          <div><strong>03</strong><span>Comparar</span><small>¿Cuál es el costo?</small></div>
          <div><strong>04</strong><span>Decidir</span><small>¿Qué paso sí puedo dar?</small></div>
        </div>
        <div class="decision-board__foot">
          <span class="eyebrow-data">saldo de claridad</span><strong>+ una pregunta útil</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="site-shell intro-strip">
      <div>
        <span class="kicker">La pregunta central</span><h2>
          ¿Cómo tomamos decisiones económicas más responsables?
        </h2>
      </div>
      <p>
        La problemática es la insuficiencia de conocimientos y hábitos sobre presupuesto, ahorro y
        crédito. Este blog documenta una intervención educativa, no una asesoría comercial.
      </p>
    </div>
  </section>

  <section class="section project-state">
    <div class="site-shell">
      <div class="section-heading">
        <span class="kicker">Estado del proyecto</span><h2>
          La evidencia también tiene un estado.
        </h2><p>
          Lo planeado, lo que está en desarrollo y lo ejecutado se muestran por separado para no
          confundir intención con resultado.
        </p>
      </div>
      <div class="state-grid">
        <div class="state-card state-card--accent">
          <span class="eyebrow-data">Territorio</span><strong>Neiva, Huila</strong><p>
            Una comunidad cercana al trabajo, la universidad y las conversaciones cotidianas.
          </p>
        </div>
        <div class="state-card">
          <span class="eyebrow-data">Proyecto</span><strong>Humanidades Digitales</strong><p>
            Seis publicaciones, una entrevista y un webinar como ruta de aprendizaje.
          </p>
        </div>
        <div class="state-card">
          <span class="eyebrow-data">Estado general</span><StatusBadge status="en-desarrollo" /><p>
            {projectStatus.currentStage}
          </p>
        </div>
      </div>
    </div>
  </section>

  {
    featured && (
      <section class="section latest-section">
        <div class="site-shell">
          <div class="section-heading section-heading--split">
            <>
              <div>
                <>
                  <span class="kicker">Entrada destacada</span>
                  <h2>Una pausa antes de aceptar.</h2>
                </>
              </div>
              <a class="text-arrow" href={`/actividades/${featured.id}/`}>
                Abrir actividad →
              </a>
            </>
          </div>
          <ActivityCard activity={featured} featured />
        </div>
      </section>
    )
  }

  <section class="section timeline-section">
    <div class="site-shell">
      <div class="section-heading">
        <span class="kicker">Línea de tiempo</span><h2>
          Un proyecto que se actualiza por semanas.
        </h2>
      </div>
      <ol class="timeline">
        {
          projectTimeline.map((item) => (
            <li>
              <>
                <span class="timeline__week">{item.week}</span>
                <div>
                  <>
                    <h3>{item.title}</h3>
                    <p>{item.detail}</p>
                  </>
                </div>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section deliveries-section">
    <div class="site-shell">
      <div class="section-heading section-heading--split">
        <div><span class="kicker">Biblioteca pública</span><h2>Entregas disponibles.</h2></div>
        <a class="text-arrow" href="/documentos/">Abrir documentos →</a>
      </div>
      <div class="deliveries-grid">
        {documents.map((document) => <DocumentCard document={document} />)}
      </div>
    </div>
  </section>

  <section class="section home-links">
    <div class="site-shell home-links__grid">
      <a href="/actividades/actividad-2-decisiones-que-si-suman/" class="big-link"
        ><span class="eyebrow-data">Actividad 2</span><strong
          >Nombrar el problema para poder escucharlo.</strong
        ><span>Contexto, territorio y propósito →</span></a
      >
      <a
        href="/actividades/actividad-4-del-diagnostico-a-la-accion/"
        class="big-link big-link--warm"
        ><span class="eyebrow-data">Actividad 4</span><strong>Del diagnóstico a la acción.</strong
        ><span>Dos herramientas para decidir mejor →</span></a
      >
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    padding-top: clamp(3rem, 9vw, 8rem);
    overflow: hidden;
  }
  .home-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.82fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .home-hero__copy {
    position: relative;
    z-index: 1;
  }
  .home-hero h1 {
    margin: 1.1rem 0 1.2rem;
  }
  .home-hero h1 em {
    color: var(--terracotta);
    font-weight: 500;
  }
  .decision-board {
    position: relative;
    padding: 1.25rem;
    border: 1px solid var(--ink);
    background: var(--petrol);
    color: var(--paper);
    box-shadow: 14px 14px 0 var(--terracotta);
    transform: rotate(1.8deg);
  }
  .decision-board::after {
    position: absolute;
    inset: 0.55rem;
    border: 1px solid rgba(247, 241, 231, 0.28);
    content: '';
    pointer-events: none;
  }
  .decision-board__head,
  .decision-board__foot {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }
  .decision-board .eyebrow-data {
    color: var(--mist);
  }
  .board-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--gold);
  }
  .balance-line {
    position: relative;
    z-index: 1;
    display: flex;
    height: 6rem;
    align-items: center;
    justify-content: space-between;
    margin-block: 1.5rem;
  }
  .balance-line::before {
    position: absolute;
    right: 0;
    left: 0;
    height: 2px;
    background: var(--terracotta);
    content: '';
    transform: rotate(-8deg);
  }
  .balance-line span {
    position: relative;
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--paper);
    border-radius: 50%;
    background: var(--terracotta);
  }
  .decision-board__steps {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin-bottom: 2rem;
    background: rgba(247, 241, 231, 0.24);
  }
  .decision-board__steps div {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 0.8rem;
    background: var(--petrol);
  }
  .decision-board__steps strong {
    color: var(--paper);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.72rem;
  }
  .decision-board__steps span {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.35rem;
  }
  .decision-board__steps small {
    color: var(--mist);
    font-size: 0.72rem;
  }
  .decision-board__foot {
    position: relative;
    z-index: 1;
    padding-top: 0.8rem;
    border-top: 1px solid rgba(247, 241, 231, 0.28);
  }
  .decision-board__foot strong {
    color: var(--paper);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.15rem;
  }
  .intro-strip {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: end;
    padding-block: 2rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .intro-strip h2 {
    max-width: 14ch;
    margin: 0.6rem 0 0;
    font-size: clamp(2.1rem, 4vw, 4rem);
  }
  .intro-strip p {
    max-width: 46ch;
    margin: 0;
    color: var(--ink-soft);
  }
  .state-grid {
    display: grid;
    grid-template-columns: 1.1fr 1.1fr 0.8fr;
    gap: 1rem;
  }
  .state-card {
    min-height: 12rem;
    padding: 1.3rem;
    border-top: 1px solid var(--petrol);
    background: var(--white);
  }
  .state-card--accent {
    border-top-color: var(--terracotta);
    background: var(--terracotta);
    color: var(--white);
  }
  .state-card strong {
    display: block;
    margin-block: 1.2rem 0.5rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.8rem;
    line-height: 1.05;
  }
  .state-card p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .state-card--accent p {
    color: var(--white);
    opacity: 0.9;
  }
  .state-card--accent .eyebrow-data {
    color: var(--white);
  }
  .section-heading--split {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: end;
  }
  .text-arrow {
    color: var(--petrol);
    font-weight: 800;
    text-decoration: none;
  }
  .timeline {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .timeline li {
    position: relative;
    min-height: 13rem;
    padding: 1rem 1rem 0 0;
    border-top: 2px solid var(--terracotta);
  }
  .timeline li + li {
    padding-left: 1rem;
    border-left: 1px solid var(--line);
  }
  .timeline__week {
    color: var(--terracotta);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.78rem;
    font-weight: 800;
  }
  .timeline h3 {
    margin: 2.5rem 0 0.5rem;
    font-size: 1.5rem;
  }
  .timeline p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .home-links__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .deliveries-grid {
    display: grid;
    gap: 1.2rem;
  }
  .deliveries-grid .document-card {
    box-shadow: none;
  }
  .big-link {
    display: grid;
    min-height: 18rem;
    align-content: space-between;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--mist);
    color: var(--ink);
    text-decoration: none;
  }
  .big-link--warm {
    background: var(--terracotta);
    color: var(--white);
  }
  .big-link--warm .eyebrow-data,
  .big-link--warm span:last-child {
    color: var(--white);
  }
  .big-link strong {
    max-width: 12ch;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1;
  }
  .big-link span:last-child {
    font-size: 0.86rem;
    font-weight: 800;
  }
  @media (max-width: 780px) {
    .home-hero__grid,
    .intro-strip,
    .state-grid {
      grid-template-columns: 1fr;
    }
    .decision-board {
      max-width: 34rem;
      margin-inline: auto;
    }
    .timeline {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .timeline li + li {
      padding-left: 0;
      border-left: 0;
    }
  }
  @media (max-width: 560px) {
    .home-links__grid {
      grid-template-columns: 1fr;
    }
    .section-heading--split {
      display: grid;
    }
  }
</style>
