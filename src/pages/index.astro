---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ActivityCard from '../components/ActivityCard.astro';
import StatusBadge from '../components/StatusBadge.astro';
import DocumentCard from '../components/DocumentCard.astro';
import PublicationCard from '../components/PublicationCard.astro';
import DiagnosticSummary from '../components/DiagnosticSummary.astro';
import YouTubeLite from '../components/YouTubeLite.astro';
import ResultsComparison from '../components/ResultsComparison.astro';
import ProjectResultsDashboard from '../components/ProjectResultsDashboard.astro';
import { sortActivities } from '../lib/content';
import { projectStatus, projectTimeline, projectWeeks } from '../lib/project';
import { sortDocuments, validateDocuments } from '../lib/documents';
import { getPublicationProgress, publications } from '../lib/publications';
import { financialResults } from '../data/diagnostic';

const activities = sortActivities(await getCollection('activity', ({ data }) => !data.draft));
const featured = activities.find((activity) => activity.data.featured) ?? activities[0];
const documents = sortDocuments(await getCollection('document'));
validateDocuments(documents);
const publicationProgress = getPublicationProgress(publications);
const weeksByName = new Map(projectWeeks.map((item) => [item.week, item]));
const projectIndicators = [
  { value: '6', label: 'Publicaciones' },
  { value: '16', label: 'Respuestas diagnósticas' },
  { value: '6', label: 'Respuestas posteriores' },
  { value: String(financialResults.totalResponseCount), label: 'Respuestas registradas en total' },
  { value: '1', label: 'Entrevista' },
  { value: '1', label: 'Webinar' },
  { value: '69:01', label: 'Duración del webinar' },
  { value: '1', label: 'Informe final y autoevaluación' },
] as const;
---

<BaseLayout
  title="Educación financiera | Decisiones que sí suman"
  socialTitle="Educación financiera para decidir mejor"
  description="Proyecto académico de Humanidades Digitales sobre presupuesto, ahorro, crédito responsable y prevención del fraude en Neiva, Huila."
  mainClass="home-page"
>
  <section class="home-hero section">
    <div class="site-shell home-hero__grid">
      <div class="home-hero__copy">
        <span class="kicker">Blog académico · Neiva, Huila</span>
        <h1>Decisiones que <em>sí</em> suman.</h1>
        <p class="lede">
          Educación financiera para organizar mejor el dinero, preguntar antes de decidir y
          construir hábitos posibles en la vida cotidiana.
        </p>
        <div class="button-row">
          <a class="button" href="/actividades/"
            >Explorar actividades <span aria-hidden="true">↗</span></a
          >
          <a class="button button--quiet" href="/plan-humanidades-digitales/">Ver el plan</a>
        </div>
      </div>
      <div class="decision-board" aria-label="Ruta visual de una decisión financiera">
        <div class="decision-board__head">
          <span class="eyebrow-data">Cuaderno de trabajo / 01</span>
          <span class="board-dot" aria-hidden="true"></span>
        </div>
        <div class="balance-line" data-motion="balance-line" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="decision-board__steps">
          <div><strong>01</strong><span>Observar</span><small>¿Qué está pasando?</small></div>
          <div><strong>02</strong><span>Ordenar</span><small>¿Qué entra y sale?</small></div>
          <div><strong>03</strong><span>Comparar</span><small>¿Cuál es el costo?</small></div>
          <div><strong>04</strong><span>Decidir</span><small>¿Qué paso sí puedo dar?</small></div>
        </div>
        <div class="decision-board__foot">
          <span class="eyebrow-data">saldo de claridad</span><strong>+ una pregunta útil</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="section priority-section" aria-labelledby="priority-title">
    <div class="site-shell">
      <div class="section-heading priority-section__heading">
        <span class="kicker">Encuentra lo importante</span>
        <h2 id="priority-title">Elige una ruta y llega directo al contenido.</h2>
        <p>
          No necesitas recorrer toda la página. Empieza por el tema, los resultados o las evidencias
          que quieres consultar.
        </p>
      </div>
      <nav class="priority-navigation" aria-label="Accesos prioritarios">
        <a class="priority-link" href="/recursos/">
          <span class="eyebrow-data">Para aprender</span>
          <strong>Aprender por tema</strong>
          <span>Presupuesto, ahorro, crédito y prevención del fraude →</span>
        </a>
        <a class="priority-link priority-link--warm" href="/resultados/">
          <span class="eyebrow-data">Para entender el alcance</span>
          <strong>Ver resultados</strong>
          <span>Diagnóstico, evaluación, cierre y límites →</span>
        </a>
        <a class="priority-link" href="/documentos/">
          <span class="eyebrow-data">Para comprobar</span>
          <strong>Revisar evidencias</strong>
          <span>Documentos, versiones públicas, videos y soportes →</span>
        </a>
      </nav>
    </div>
  </section>

  <section class="section section--tight">
    <div class="site-shell intro-strip">
      <div>
        <span class="kicker">La pregunta central</span><h2>
          ¿Cómo tomamos decisiones económicas más responsables?
        </h2>
      </div>
      <p>
        La problemática es la insuficiencia de conocimientos y hábitos sobre presupuesto, ahorro y
        crédito. Este blog documenta una intervención educativa, no una asesoría comercial.
      </p>
    </div>
  </section>

  <section class="section journey-section" id="recorrido">
    <div class="site-shell">
      <div class="section-heading section-heading--split">
        <div>
          <span class="kicker">Del diagnóstico a la acción</span>
          <h2>Un recorrido ejecutado y documentado.</h2>
        </div>
        <a class="button" href="/actividades/actividad-6-de-la-informacion-a-la-accion/">
          Ver recorrido del proyecto →
        </a>
      </div>
      <dl class="journey-metrics" aria-label="Indicadores generales del proyecto">
        {
          projectIndicators.map((indicator) => (
            <div>
              <dd>{indicator.value}</dd>
              <dt>{indicator.label}</dt>
            </div>
          ))
        }
      </dl>
      <p class="journey-sequence">
        Planificación → diagnóstico → ejecución → intervención → evaluación → reflexión
      </p>
    </div>
  </section>

  <section class="section project-state">
    <div class="site-shell">
      <div class="section-heading">
        <span class="kicker">Estado del proyecto</span><h2>
          La evidencia también tiene un estado.
        </h2><p>
          Lo planeado, lo que está en desarrollo y lo ejecutado se muestran por separado para no
          confundir intención con resultado.
        </p>
      </div>
      <div class="state-grid">
        <div class="state-card state-card--accent">
          <span class="eyebrow-data">Territorio</span><strong>Neiva, Huila</strong><p>
            Una comunidad cercana al trabajo, la universidad y las conversaciones cotidianas.
          </p>
        </div>
        <div class="state-card">
          <span class="eyebrow-data">Proyecto</span><strong>Humanidades Digitales</strong><p>
            Seis publicaciones, una entrevista, un webinar, evaluación posterior y reflexión final
            publicados como ruta de aprendizaje.
          </p>
        </div>
        <div class="state-card">
          <span class="eyebrow-data">Estado general</span><StatusBadge
            status={projectStatus.status}
          /><p>
            {projectStatus.currentStage}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section execution-section" id="ejecucion-proyecto">
    <div class="site-shell">
      <div class="execution-intro">
        <div class="section-heading">
          <span class="kicker">Ejecución del proyecto</span>
          <h2>Publicaciones realizadas en Facebook.</h2>
          <p>
            Durante las semanas 4, 5 y 6 se desarrollaron y publicaron seis contenidos educativos de
            Decisiones que sí suman. Las piezas presentan conceptos financieros de forma clara,
            visual y cercana, promoviendo la reflexión y la participación de la comunidad.
          </p>
        </div>
        <div class="execution-progress">
          <span class="eyebrow-data">Avance del componente de publicaciones</span>
          <strong
            >{publicationProgress.current} de {publicationProgress.total} publicaciones realizadas</strong
          >
          <progress
            value={publicationProgress.current}
            max={publicationProgress.total}
            aria-label="Progreso del componente de publicaciones"></progress>
          <span class="execution-progress__note"
            >Las seis publicaciones y sus evidencias están registradas.</span
          >
        </div>
      </div>
      <div class="publications-grid">
        {publications.map((publication) => <PublicationCard publication={publication} />)}
      </div>
      <div class="execution-footer">
        <p>
          Las publicaciones 5 y 6 cuentan con evidencia visual en sus PDF y en el consolidado de
          pruebas. El componente de publicaciones está completado: 6 de 6.
        </p>
        <a
          class="button"
          href="https://www.facebook.com/share/1DPqucucd7/"
          target="_blank"
          rel="noopener noreferrer">Visitar la página de Facebook ↗</a
        >
      </div>
    </div>
  </section>

  <section class="section evidence-section" id="diagnostico">
    <div class="site-shell">
      <DiagnosticSummary />
    </div>
  </section>

  <section class="section evidence-section" id="entrevista">
    <div class="site-shell evidence-section__grid">
      <YouTubeLite
        videoId="mLFCR_STZ2Q"
        title="Educación financiera para tomar mejores decisiones | Entrevista"
        thumbnail="/assets/miniaturas/videos/entrevista.jpg"
        thumbnailAlt="Vista de la entrevista sobre educación financiera y mejores decisiones."
        youtubeHref="https://youtu.be/mLFCR_STZ2Q"
        description="Edición académica publicada con autorización audiovisual para grabar y utilizar fragmentos dentro del proyecto. Su duración verificada es 7:20, por debajo de la meta original de 15 minutos."
        duration="7:20"
        playLabel="Cargar reproductor de la entrevista"
        label="Semana 5 · Entrevista"
      />
      <div class="evidence-column">
        <div class="section-heading">
          <span class="kicker">Sección de evidencias</span>
          <h2>Lo realizado, sin confundir alcance con impacto.</h2>
          <p>
            Las evidencias permiten describir la ejecución y observar tendencias. No permiten
            atribuir causalidad ni generalizar los resultados a toda la población.
          </p>
        </div>
        <div class="consent-record">
          <div class="consent-record__heading">
            <StatusBadge status="completada" label="AUTORIZACIÓN VERIFICADA" />
            <p>Constancia audiovisual · 41 segundos</p>
          </div>
          <video
            controls
            preload="none"
            playsinline
            aria-label="Constancia audiovisual de autorización para la entrevista"
          >
            <source src="/media/video/permiso-entrevista.mp4" type="video/mp4" />
            Tu navegador no puede reproducir este video. <a
              href="/media/video/permiso-entrevista.mp4">Abrir constancia ↗</a
            >
          </video>
          <details class="consent-record__transcript">
            <summary>Leer transcripción completa del permiso</summary>
            <p>
              <strong>Entrevistador:</strong> “Buenas tardes, mi nombre es José Carlos Gómez [segundo
              apellido omitido en la versión pública]. Soy estudiante de la actividad Práctica en Responsabilidad
              Social de UNIMINUTO. Actualmente estoy desarrollando un proyecto de Humanidades Digitales
              llamado Decisiones que sí suman, enfocado en educación financiera, presupuesto, ahorro,
              crédito responsable y prevención del fraude. El objetivo de esta entrevista es conocer,
              desde la experiencia de una profesional del sector financiero, algunas recomendaciones que
              puedan ayudar a las personas a tomar decisiones más informadas y evitar el sobreendeudamiento.
              Antes de comenzar, quisiera preguntarte: ¿nos autorizas a grabar esta entrevista y utilizar
              algunos fragmentos con fines exclusivamente académicos y educativos dentro del proyecto?”
            </p>
            <p><strong>Persona entrevistada:</strong> “Sí, claro que sí.”</p>
          </details>
        </div>
        <div class="evidence-links">
          <strong>Evidencia digital agregada</strong>
          <p>
            Las capturas públicas conservan únicamente estadísticas globales y por publicación. Las
            evidencias con nombres, perfiles o enlaces privados se mantienen fuera del sitio.
          </p>
          <div>
            <a href="/assets/evidencias/resultados/estadisticas-generales.png"
              >Ver rendimiento global ↗</a
            >
            <a href="/assets/evidencias/resultados/estadisticas-publicaciones.png"
              >Ver estadísticas por publicación ↗</a
            >
          </div>
        </div>
        <div class="evidence-status-list" aria-label="Estado de evidencias principales">
          <div><span>Plan</span><strong>DISPONIBLE</strong></div>
          <div><span>Diagnóstico</span><strong>COMPLETADO · 16 respuestas</strong></div>
          <div><span>Publicaciones educativas</span><strong>COMPLETADA · 6 de 6</strong></div>
          <div><span>Entrevista</span><strong>COMPLETADA · YouTube</strong></div>
          <div><span>Webinar</span><strong>COMPLETADO · YouTube</strong></div>
          <div><span>Evaluación posterior</span><strong>COMPLETADA · 6 respuestas</strong></div>
          <div><span>Informe final</span><strong>COMPLETADO · YouTube</strong></div>
          <div><span>Seguimiento final</span><strong>COMPLETADO · 9 respuestas</strong></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section webinar-section" id="webinar">
    <div class="site-shell">
      <YouTubeLite
        videoId="StYZ2l1TA3U"
        title="Webinar: Decisiones que sí suman"
        thumbnail="/assets/miniaturas/videos/webinar.webp"
        thumbnailAlt="Miniatura del webinar Decisiones que sí suman sobre educación financiera."
        youtubeHref="https://youtu.be/StYZ2l1TA3U"
        description="Encuentro educativo sobre decisiones financieras responsables en el que se abordaron presupuesto, ahorro, crédito, capacidad de pago y prevención del fraude mediante ejemplos y ejercicios prácticos."
        duration="69:01"
        playLabel="Cargar reproductor del webinar"
        label="Semana 6 · 9 de agosto de 2026"
      />
      <div class="webinar-context">
        <div>
          <span class="eyebrow-data">Temas desarrollados</span>
          <p>
            Presupuesto, registro de gastos, gastos pequeños, ahorro, fondo de emergencia, crédito
            responsable, tasa, cuota, plazo, costo total, capacidad de pago, señales de
            sobreendeudamiento y prevención del fraude.
          </p>
        </div>
        <div>
          <span class="eyebrow-data">Relación con el plan</span>
          <p>
            La duración de 69:01 está dentro del rango previsto de 60 a 75 minutos. La evaluación
            posterior cuenta con seis respuestas.
          </p>
        </div>
        <div>
          <span class="eyebrow-data">Alcance</span>
          <p><strong>236 visualizaciones · meta de más de 20 superada.</strong></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section project-results-section" id="alcance-digital">
    <div class="site-shell">
      <ProjectResultsDashboard />
      <div class="closure-callout">
        <div>
          <span class="eyebrow-data">Semana 7 · Completada</span>
          <h3>Encuesta final consolidada.</h3>
          <p>
            Nueve respuestas: satisfacción 4,6/5, utilidad 5/5 y 100 % de aplicación total o
            parcial.
          </p>
        </div>
        <a class="button" href="/resultados/">Ver resultados completos →</a>
      </div>
    </div>
  </section>

  <section class="section results-section" id="resultados">
    <div class="site-shell"><ResultsComparison /></div>
  </section>

  <section class="section academic-week-section" id="actividad-semana-6">
    <div class="site-shell">
      <div class="section-heading">
        <span class="kicker">Actividad académica 6</span>
        <h2>De la información a la acción.</h2>
        <p>
          La entrada final y el video de autoevaluación documentan la experiencia social, los
          resultados descriptivos, las dificultades, los aprendizajes y las oportunidades de mejora.
        </p>
      </div>
      <div class="academic-week-card">
        <StatusBadge status="completada" />
        <ul>
          <li>Informe final y autoevaluación: publicado, duración 5:56.</li>
          <li>Cuarta entrada del blog: publicada.</li>
          <li>Presentación original: disponible bajo demanda.</li>
        </ul>
        <a
          class="button button--small"
          href="/actividades/actividad-6-de-la-informacion-a-la-accion/"
        >
          Ver Actividad 6 →
        </a>
      </div>
    </div>
  </section>

  {
    featured && (
      <section class="section latest-section">
        <div class="site-shell">
          <div class="section-heading section-heading--split">
            <>
              <div>
                <>
                  <span class="kicker">Entrada destacada</span>
                  <h2>Una pausa antes de aceptar.</h2>
                </>
              </div>
              <a class="text-arrow" href={`/actividades/${featured.id}/`}>
                Abrir actividad →
              </a>
            </>
          </div>
          <ActivityCard activity={featured} featured />
        </div>
      </section>
    )
  }

  <section class="section timeline-section">
    <div class="site-shell">
      <div class="section-heading">
        <span class="kicker">Línea de tiempo</span><h2>
          Un proyecto que se actualiza por semanas.
        </h2>
      </div>
      <ol class="timeline">
        {
          projectTimeline.map((item) => (
            <li>
              <>
                <div class="timeline__meta">
                  <span class="timeline__week">{item.week}</span>
                  <StatusBadge
                    status={weeksByName.get(item.week)?.status ?? 'pendiente'}
                    label={weeksByName.get(item.week)?.label}
                  />
                </div>
                <div>
                  <>
                    <h3>{item.title}</h3>
                    <p>{item.detail}</p>
                  </>
                </div>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section deliveries-section">
    <div class="site-shell">
      <div class="section-heading section-heading--split">
        <div><span class="kicker">Biblioteca pública</span><h2>Entregas disponibles.</h2></div>
        <a class="text-arrow" href="/documentos/">Abrir documentos →</a>
      </div>
      <div class="deliveries-grid">
        {documents.map((document) => <DocumentCard document={document} />)}
      </div>
    </div>
  </section>

  <section class="section home-links">
    <div class="site-shell home-links__grid">
      <a href="/actividades/actividad-2-decisiones-que-si-suman/" class="big-link"
        ><span class="eyebrow-data">Actividad 2</span><strong
          >Nombrar el problema para poder escucharlo.</strong
        ><span>Contexto, territorio y propósito →</span></a
      >
      <a
        href="/actividades/actividad-4-del-diagnostico-a-la-accion/"
        class="big-link big-link--warm"
        ><span class="eyebrow-data">Actividad 4</span><strong>Del diagnóstico a la acción.</strong
        ><span>Dos herramientas para decidir mejor →</span></a
      >
      <a href="/actividades/actividad-6-de-la-informacion-a-la-accion/" class="big-link"
        ><span class="eyebrow-data">Actividad 6</span><strong>De la información a la acción.</strong
        ><span>Video, resultados y reflexión profesional →</span></a
      >
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    padding-top: clamp(3rem, 9vw, 8rem);
    overflow: hidden;
  }
  .home-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.82fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .home-hero__copy {
    position: relative;
    z-index: 1;
  }
  .home-hero h1 {
    margin: 1.1rem 0 1.2rem;
  }
  .home-hero h1 em {
    color: var(--terracotta);
    font-weight: 500;
  }
  .decision-board {
    position: relative;
    padding: 1.25rem;
    border: 1px solid var(--ink);
    background: var(--petrol);
    color: var(--paper);
    box-shadow: 14px 14px 0 var(--terracotta);
    transform: rotate(1.8deg);
  }
  .decision-board::after {
    position: absolute;
    inset: 0.55rem;
    border: 1px solid rgba(247, 241, 231, 0.28);
    content: '';
    pointer-events: none;
  }
  .decision-board__head,
  .decision-board__foot {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }
  .decision-board .eyebrow-data {
    color: var(--mist);
  }
  .board-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--gold);
  }
  .balance-line {
    position: relative;
    z-index: 1;
    display: flex;
    height: 6rem;
    align-items: center;
    justify-content: space-between;
    margin-block: 1.5rem;
  }
  .balance-line::before {
    position: absolute;
    right: 0;
    left: 0;
    height: 2px;
    background: var(--terracotta);
    content: '';
    transform: rotate(-8deg) scaleX(1);
    transform-origin: left center;
    animation: balance-line-draw var(--motion-authored) var(--motion-ease-out) 120ms both;
  }
  .balance-line span {
    position: relative;
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--paper);
    border-radius: 50%;
    background: var(--terracotta);
    animation: balance-node-mark 360ms var(--motion-ease-out) both;
  }
  .balance-line span:nth-child(1) {
    animation-delay: 230ms;
  }
  .balance-line span:nth-child(2) {
    animation-delay: 290ms;
  }
  .balance-line span:nth-child(3) {
    animation-delay: 350ms;
  }
  .balance-line span:nth-child(4) {
    animation-delay: 410ms;
  }
  .decision-board__steps {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin-bottom: 2rem;
    background: rgba(247, 241, 231, 0.24);
  }
  .decision-board__steps div {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 0.8rem;
    background: var(--petrol);
  }
  .decision-board__steps strong {
    color: var(--paper);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.72rem;
  }
  .decision-board__steps span {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.35rem;
  }
  .decision-board__steps small {
    color: var(--mist);
    font-size: 0.72rem;
  }
  .decision-board__foot {
    position: relative;
    z-index: 1;
    padding-top: 0.8rem;
    border-top: 1px solid rgba(247, 241, 231, 0.28);
  }
  .decision-board__foot strong {
    color: var(--paper);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.15rem;
  }
  @keyframes balance-line-draw {
    from {
      transform: rotate(-8deg) scaleX(0);
    }

    to {
      transform: rotate(-8deg) scaleX(1);
    }
  }
  @keyframes balance-node-mark {
    from {
      opacity: 0;
      transform: scale(0.72);
    }

    to {
      opacity: 1;
