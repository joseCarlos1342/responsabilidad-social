---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { odsData } from '../lib/content';

const activities = await getCollection('activity', ({ data }) => !data.draft);
---

<BaseLayout
  title="ODS y responsabilidad social"
  description="Relaciones argumentadas entre las actividades del proyecto y los Objetivos de Desarrollo Sostenible."
>
  <section class="section">
    <div class="site-shell">
      <Breadcrumbs items={[{ label: 'ODS' }]} /><header class="simple-header">
        <span class="kicker">No solo iconos</span><h1>ODS con alcance realista.</h1><p class="lede">
          Cada relación debe explicar qué acción concreta aporta, qué alcance puede tener y qué
          limitación conviene reconocer.
        </p>
      </header><div class="ods-page-grid">
        {
          odsData.map((ods) => (
            <article class="ods-page-item" style={`--ods-color: ${ods.color}`}>
              <strong>ODS {ods.number}</strong>
              <h2>{ods.name}</h2>
              <p>{ods.explanation}</p>
              <dl class="ods-details">
                <div>
                  <>
                    <dt>Acción relacionada</dt>
                    <dd>{ods.action}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>Alcance realista</dt>
                    <dd>{ods.scope}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>Limitación</dt>
                    <dd>{ods.limitation}</dd>
                  </>
                </div>
              </dl>
              <div class="ods-activities">
                <span class="eyebrow-data">Actividades relacionadas</span>
                {activities
                  .filter((activity) => activity.data.ods.includes(ods.number))
                  .map((activity) => (
                    <a href={`/actividades/${activity.id}/`}>
                      Actividad {activity.data.activityNumber} →
                    </a>
                  ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .simple-header {
    max-width: 760px;
    padding-block: 3rem 4rem;
  }
  .simple-header h1 {
    max-width: 12ch;
    margin: 0.8rem 0 1rem;
  }
  .ods-page-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .ods-page-item {
    min-height: 14rem;
    padding: 1.5rem;
    border-top: 2px solid var(--ods-color);
    background: var(--white);
  }
  .ods-page-item strong {
    color: var(--petrol);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.78rem;
  }
  .ods-page-item h2 {
    margin: 1.2rem 0 0.7rem;
    font-size: 2rem;
  }
  .ods-page-item p {
    margin: 0;
    color: var(--ink-soft);
  }
  .ods-details {
    display: grid;
    gap: 0.8rem;
    margin: 1.4rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .ods-details div {
    display: grid;
    gap: 0.2rem;
  }
  .ods-details dt {
    color: var(--petrol);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
  }
  .ods-details dd {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .ods-activities {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.3rem;
  }
  .ods-activities a {
    color: var(--petrol);
    font-size: 0.88rem;
    font-weight: 800;
  }
  @media (max-width: 650px) {
    .ods-page-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
