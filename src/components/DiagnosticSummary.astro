---
import { diagnosticSummary, financialResults } from '../data/diagnostic';

const formatPercentage = (percentage: number) => `${percentage.toLocaleString('es-CO')}%`;
---

<section class="diagnostic-summary" aria-labelledby="diagnostic-summary-title">
  <div class="section-heading">
    <span class="kicker">Diagnóstico inicial</span>
    <h2 id="diagnostic-summary-title">16 respuestas para orientar el proyecto.</h2>
    <p>
      Consolidado agregado de la aplicación inicial del cuestionario de ocho preguntas. La
      evaluación posterior se presenta por separado y no corresponde a un seguimiento emparejado.
    </p>
  </div>
  <div class="diagnostic-summary__head">
    <strong>{diagnosticSummary.responseCount} respuestas</strong>
    <span class="eyebrow-data"
      >Estado: diagnóstico completado · evaluación posterior disponible</span
    >
  </div>
  <div class="diagnostic-summary__grid">
    {
      diagnosticSummary.questions.map((item, index) => (
        <article class="diagnostic-question">
          <span class="diagnostic-question__number">0{index + 1}</span>
          <h3>{item.question}</h3>
          <ul>
            {item.options.map((option) => (
              <li>
                <div class="diagnostic-option__label">
                  <span>{option.label}</span>
                  <strong>{formatPercentage(option.percentage)}</strong>
                </div>
                <div class="diagnostic-option__track" aria-hidden="true">
                  <span style={`width: ${option.percentage}%`} />
                </div>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
  <div class="diagnostic-summary__actions">
    <a class="button button--small" href={diagnosticSummary.sourceHref} download>
      Descargar diagnóstico XLSX
    </a>
    <a class="text-link" href={financialResults.sourceHref} download>
      Descargar comparación agregada
    </a>
    <span>Los gráficos de esta sección corresponden únicamente a las 16 respuestas iniciales.</span>
  </div>
</section>

<style>
  .diagnostic-summary {
    padding: clamp(1.2rem, 3vw, 2.5rem);
    border-block: 1px solid var(--line);
    background: var(--paper-deep);
  }
  .diagnostic-summary .section-heading {
    margin-bottom: 1.5rem;
  }
  .diagnostic-summary h2 {
    max-width: 16ch;
  }
  .diagnostic-summary__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 1rem 0;
    border-block: 1px solid var(--line);
  }
  .diagnostic-summary__head strong {
    color: var(--petrol);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
  }
  .diagnostic-summary__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 1.5rem;
    background: var(--line);
  }
  .diagnostic-question {
    position: relative;
    padding: 1.25rem;
    background: var(--white);
  }
  .diagnostic-question__number {
    color: var(--terracotta);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 800;
  }
  .diagnostic-question h3 {
    margin: 0.6rem 0 1rem;
    color: var(--petrol);
    font-family: inherit;
    font-size: 1rem;
    letter-spacing: 0;
    line-height: 1.3;
  }
  .diagnostic-question ul {
    display: grid;
    gap: 0.7rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .diagnostic-option__label {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.82rem;
  }
  .diagnostic-option__label strong {
    color: var(--petrol);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  }
  .diagnostic-option__track {
    height: 0.45rem;
    margin-top: 0.25rem;
    overflow: hidden;
    background: var(--mist);
  }
  .diagnostic-option__track span {
    display: block;
    height: 100%;
    background: var(--terracotta);
  }
  .diagnostic-summary__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    align-items: center;
    margin-top: 1.5rem;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .diagnostic-summary__actions .text-link {
    color: var(--petrol);
    font-weight: 800;
  }
  @media (max-width: 700px) {
    .diagnostic-summary__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
