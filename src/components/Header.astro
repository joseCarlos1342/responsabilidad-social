---
const pathname = Astro.url.pathname;
const links = [
  { href: '/recursos/', label: 'Aprender', active: pathname.startsWith('/recursos/') },
  { href: '/resultados/', label: 'Resultados', active: pathname.startsWith('/resultados/') },
  { href: '/documentos/', label: 'Evidencias', active: pathname.startsWith('/documentos/') },
  {
    href: '/actividades/',
    label: 'Proyecto',
    active:
      pathname.startsWith('/actividades/') ||
      pathname.startsWith('/plan-humanidades-digitales/') ||
      pathname.startsWith('/proyecto/') ||
      pathname.startsWith('/territorio/') ||
      pathname.startsWith('/sobre-el-autor/'),
  },
];
---

<header class="site-header">
  <div class="site-shell header-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">↗</span>
      <span><strong>Decisiones</strong><small>que sí suman</small></span>
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Abrir menú"
    >
      <span class="sr-only" data-menu-label>Abrir menú</span>
      <span aria-hidden="true">Menú</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Navegación principal">
      {
        links.map((link) => (
          <a href={link.href} aria-current={link.active ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      <details class="video-nav" role="group" aria-label="Videos del proyecto">
        <summary>Videos</summary>
        <div class="video-nav__menu">
          <a href="/#entrevista">Entrevista · 7:20</a>
          <a href="/#webinar">Webinar · 69:01</a>
          <a href="/actividades/actividad-6-de-la-informacion-a-la-accion/#video-reflexion"
            >Informe final · 5:56</a
          >
        </div>
      </details>
      <details class="project-nav" role="group" aria-label="Más del proyecto">
        <summary>Más del proyecto</summary>
        <div class="video-nav__menu">
          <a href="/plan-humanidades-digitales/">Plan de Humanidades Digitales</a>
          <a href="/territorio/">Territorio</a>
          <a href="/sobre-el-autor/">Sobre el autor</a>
          <a href="/ods/">ODS y responsabilidad social</a>
        </div>
      </details>
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="Cambiar tema"
        aria-pressed="false"><span aria-hidden="true">◐</span></button
      >
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 2;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
  }
  .header-inner {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    text-decoration: none;
  }
  .brand-mark {
    display: grid;
    width: 2.2rem;
    height: 2.2rem;
    place-items: center;
    border: 1px solid var(--terracotta);
    border-radius: 50%;
    color: var(--terracotta);
    font-size: 1.4rem;
  }
  .brand strong,
  .brand small {
    display: block;
    line-height: 1;
  }
  .brand strong {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.1rem;
  }
  .brand small {
    margin-top: 0.25rem;
    color: var(--ink-soft);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    font-size: 0.86rem;
    font-weight: 750;
  }
  .site-nav a {
    text-decoration: none;
  }
  .site-nav > a[aria-current='page'] {
    color: var(--terracotta);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .video-nav {
    position: relative;
  }
  .video-nav summary {
    padding: 0.35rem 0;
    cursor: pointer;
    list-style: none;
  }
  .video-nav summary::-webkit-details-marker {
    display: none;
  }
  .video-nav summary::after {
    display: inline-block;
    margin-left: 0.35rem;
    color: var(--terracotta);
    content: '↓';
    font-size: 0.72rem;
    transform-origin: center;
    transition: transform var(--motion-state) var(--motion-ease-out);
  }
  .video-nav[open] summary::after {
    transform: rotate(180deg);
  }
  .video-nav__menu {
    position: absolute;
    z-index: 3;
    top: calc(100% + 0.75rem);
    right: -0.75rem;
    display: grid;
    min-width: 15rem;
    gap: 0;
    padding: 0.45rem;
    border: 1px solid var(--line);
    background: var(--paper);
    box-shadow: var(--shadow);
  }
  .video-nav__menu a {
    padding: 0.7rem 0.75rem;
    color: var(--ink);
    font-size: 0.8rem;
  }
  .video-nav__menu a:hover,
  .video-nav__menu a:focus-visible {
    background: var(--mist);
    color: var(--terracotta);
  }
  .project-nav {
    position: relative;
  }
  .theme-toggle,
  .menu-toggle {
    min-width: 42px;
    min-height: 42px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color var(--motion-state) var(--motion-ease-out),
      color var(--motion-state) var(--motion-ease-out),
      transform var(--motion-state) var(--motion-ease-out);
  }
  .theme-toggle:hover,
  .menu-toggle:hover {
    border-color: var(--terracotta);
    color: var(--terracotta);
    transform: translateY(-1px);
  }
  .theme-toggle:active,
  .menu-toggle:active {
    transform: translateY(0);
  }
  .menu-toggle {
    display: none;
    border-radius: 999px;
    padding: 0.5rem 0.8rem;
    font-size: 0.8rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 780px) {
    .menu-toggle {
      display: block;
    }
    .site-nav {
      position: absolute;
      top: calc(100% + 1px);
      right: 0.65rem;
      left: 0.65rem;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.7rem;
      border: 1px solid var(--line);
      background: var(--paper);
      box-shadow: var(--shadow);
    }
    .site-nav[data-open='true'] {
      display: flex;
      animation: mobile-menu-enter 180ms var(--motion-ease-out) both;
    }
    .site-nav a {
      padding: 0.8rem;
    }
    .video-nav summary {
      padding: 0.8rem;
    }
    .project-nav summary {
      padding: 0.8rem;
    }
    .video-nav__menu {
      position: static;
      min-width: 0;
      margin: 0 0.8rem 0.5rem;
      box-shadow: none;
    }
    .video-nav__menu a {
      padding: 0.7rem;
    }
    .theme-toggle {
      align-self: flex-start;
      margin: 0.5rem;
    }
    @keyframes mobile-menu-enter {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav[data-open='true'] {
      animation: none;
    }
  }
</style>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  const closeMenu = () => {
    nav?.setAttribute('data-open', 'false');
    menuButton?.setAttribute('aria-expanded', 'false');
    menuButton?.setAttribute('aria-label', 'Abrir menú');
    menuButton?.querySelector('[data-menu-label]')?.replaceChildren('Abrir menú');
  };
  const openMenu = () => {
    nav?.setAttribute('data-open', 'true');
    menuButton?.setAttribute('aria-expanded', 'true');
    menuButton?.setAttribute('aria-label', 'Cerrar menú');
    menuButton?.querySelector('[data-menu-label]')?.replaceChildren('Cerrar menú');
    requestAnimationFrame(() => nav?.querySelector<HTMLElement>('a, summary, button')?.focus());
  };
  menuButton?.addEventListener('click', () => {
    const open = nav?.getAttribute('data-open') === 'true';
    if (open) {
      closeMenu();
      menuButton?.focus();
    } else {
      openMenu();
    }
  });
  nav?.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Escape' && nav.getAttribute('data-open') === 'true') {
      closeMenu();
      menuButton?.focus();
    }
  });
</script>
