---
interface Props {
  pathname: string;
  enabled?: boolean;
}
const { pathname, enabled = false } = Astro.props;
const repo = import.meta.env.PUBLIC_GISCUS_REPO;
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY ?? 'Comentarios';
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;
const configured = enabled && Boolean(repo && repoId && categoryId);
---

{
  configured ? (
    <section class="comments" aria-labelledby="comments-title">
      <div class="section-heading">
        <span class="kicker">Conversación moderada</span>
        <h2 id="comments-title">Comentarios</h2>
        <p>
          Para participar necesitas una cuenta de GitHub. La conversación se aloja en Discussions y
          se modera según la política del sitio.
        </p>
      </div>
      <div
        class="giscus-shell"
        data-giscus-path={pathname}
        data-repo={repo}
        data-repo-id={repoId}
        data-category={category}
        data-category-id={categoryId}
      >
        <p class="eyebrow-data">Cargando conversación…</p>
      </div>
    </section>
  ) : (
    <aside class="comments notice" aria-label="Comentarios pendientes">
      <strong>Comentarios pendientes de configuración.</strong>
      <p>
        La interfaz está preparada para Giscus. Se activará cuando el repositorio tenga Discussions,
        la categoría “{category}” y la aplicación autorizada.
      </p>
    </aside>
  )
}

<script is:inline>
  const shell = document.querySelector('.giscus-shell');
  if (!shell) {
    // No comments are enabled on this route.
  } else {
    const repo = shell?.getAttribute('data-repo') ?? '';
    const repoId = shell?.getAttribute('data-repo-id') ?? '';
    const category = shell?.getAttribute('data-category') ?? 'Comentarios';
    const categoryId = shell?.getAttribute('data-category-id') ?? '';
    const renderGiscus = () => {
      if (!shell || shell.querySelector('iframe')) return;
      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.async = true;
      script.crossOrigin = 'anonymous';
      script.setAttribute('data-repo', repo);
      script.setAttribute('data-repo-id', repoId);
      script.setAttribute('data-category', category);
      script.setAttribute('data-category-id', categoryId);
      script.setAttribute('data-mapping', 'pathname');
      script.setAttribute('data-strict', '0');
      script.setAttribute('data-reactions-enabled', '1');
      script.setAttribute('data-emit-metadata', '0');
      script.setAttribute('data-input-position', 'top');
      script.setAttribute('data-theme', document.body.dataset.theme === 'dark' ? 'dark' : 'light');
      script.setAttribute('data-lang', 'es');
      shell.replaceChildren(script);
    };
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          renderGiscus();
          observer.disconnect();
        }
      },
      { rootMargin: '240px' },
    );
    if (shell) observer.observe(shell);
    document.addEventListener('themechange', () => {
      const frame = document.querySelector('.giscus-frame');
      frame?.contentWindow?.postMessage(
        {
          giscus: {
            setConfig: { theme: document.body.dataset.theme === 'dark' ? 'dark' : 'light' },
          },
        },
        'https://giscus.app',
      );
    });
  }
</script>

<style>
  .comments {
    margin-top: 3rem;
  }
  .giscus-shell {
    min-height: 8rem;
  }
</style>
