---
interface Props {
  videoId: string;
  title: string;
  thumbnail: string;
  thumbnailAlt: string;
  youtubeHref: string;
  description: string;
  duration?: string;
  playLabel?: string;
  label?: string;
  id?: string;
}

const {
  videoId,
  title,
  thumbnail,
  thumbnailAlt,
  youtubeHref,
  description,
  duration,
  playLabel = 'Cargar reproductor',
  label = 'Evidencia audiovisual',
  id,
} = Astro.props;
const titleId = `video-title-${videoId}`;
const statusId = `video-status-${videoId}`;
---

<section
  class="youtube-lite"
  id={id}
  aria-labelledby={titleId}
  data-youtube-lite
  data-video-id={videoId}
  data-video-title={title}
>
  <div class="youtube-lite__header">
    <div>
      <span class="kicker">{label}</span>
      <h2 id={titleId}>{title}</h2>
    </div>
    <span class="eyebrow-data">
      Reproducción bajo interacción{duration ? ` · ${duration}` : ''}
    </span>
  </div>
  <div class="youtube-lite__frame" data-youtube-frame>
    <img
      src={thumbnail}
      alt={thumbnailAlt}
      width="480"
      height="360"
      loading="lazy"
      decoding="async"
    />
    <button
      type="button"
      class="youtube-lite__play"
      data-youtube-play
      aria-label={`${playLabel}: ${title}`}
    >
      <span aria-hidden="true">▶</span>
      <span>{playLabel}</span>
    </button>
    <noscript>
      <p class="youtube-lite__noscript">
        JavaScript está desactivado. <a href={youtubeHref}>Abrir video en YouTube ↗</a>
      </p>
    </noscript>
  </div>
  <p class="youtube-lite__status" id={statusId} data-youtube-status aria-live="polite">
    El reproductor se cargará al activar este video. También puedes abrirlo directamente en YouTube.
  </p>
  <p class="youtube-lite__caption">{description}</p>
  <a class="text-link" href={youtubeHref} target="_blank" rel="noopener noreferrer">
    Abrir en YouTube ↗
  </a>
</section>

<style>
  .youtube-lite {
    padding: clamp(1.2rem, 3vw, 2.5rem);
    border: 1px solid var(--line);
    background: var(--white);
    box-shadow: 0 5px 0 var(--line);
  }
  .youtube-lite__header {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }
  .youtube-lite h2 {
    max-width: 15ch;
    margin: 0.6rem 0 0;
    color: var(--petrol);
    font-size: clamp(2rem, 5vw, 4rem);
  }
  .youtube-lite__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #111;
  }
  .youtube-lite__frame img,
  .youtube-lite__frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  .youtube-lite__play {
    position: absolute;
    z-index: 1;
    inset: 50% auto auto 50%;
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    min-height: 52px;
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--paper);
    border-radius: 999px;
    background: var(--petrol);
    color: var(--paper);
    cursor: pointer;
    font-weight: 800;
    transform: translate(-50%, -50%);
  }
  .youtube-lite__play:hover {
    background: var(--terracotta);
  }
  .youtube-lite__play span:first-child {
    font-size: 1.1rem;
  }
  .youtube-lite__caption {
    margin: 1rem 0 0.5rem;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .youtube-lite__status {
    margin: 0.8rem 0 0;
    color: var(--ink-soft);
    font-size: 0.82rem;
  }
  .youtube-lite .text-link {
    color: var(--petrol);
    font-weight: 800;
    text-decoration: none;
  }
  .youtube-lite__noscript {
    position: absolute;
    inset: auto 1rem 1rem;
    padding: 0.75rem;
    background: var(--paper);
    color: var(--ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .youtube-lite__play {
      transform: translate(-50%, -50%);
    }
  }
</style>

<script>
  const youtubeCards = document.querySelectorAll<HTMLElement>('[data-youtube-lite]');

  youtubeCards.forEach((card) => {
    const play = card.querySelector<HTMLButtonElement>('[data-youtube-play]');
    const frame = card.querySelector<HTMLElement>('[data-youtube-frame]');
    const status = card.querySelector<HTMLElement>('[data-youtube-status]');
    if (!play || !frame) return;
    play.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        const videoId = card.dataset.videoId;
        const videoTitle = card.dataset.videoTitle;
        if (!videoId) return;
        iframe.className = 'youtube-lite__iframe';
        iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?rel=0`;
        iframe.title = videoTitle ?? 'Video del proyecto Decisiones que sí suman';
        if (status?.id) iframe.setAttribute('aria-describedby', status.id);
        iframe.loading = 'lazy';
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        iframe.setAttribute(
          'allow',
          'accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share',
        );
        frame.replaceChildren(iframe);
        if (status) status.textContent = 'Reproductor cargado. Usa los controles de YouTube.';
      },
      { once: true },
    );
  });
</script>
