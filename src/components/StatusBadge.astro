---
import { statusLabels } from '../lib/content';
import type { ContentStatus } from '../lib/content';

interface Props {
  status: ContentStatus;
  onAccent?: boolean;
}
const { status, onAccent = false } = Astro.props;
---

<span class:list={['status', `status--${status}`, { 'status--accent': onAccent }]}
  >{statusLabels[status]}</span
>

<style>
  .status--accent {
    border-color: var(--white);
    color: var(--white);
  }
</style>
